# Per-agent tools configuration
# Copy to ~/.cireilclaw/agents/{slug}/config/tools.toml
#
# Simple tools: set to true/false to enable/disable.
# The exec tool has its own config object.
# Tools are enabled only when listed here and set to true.

# --- Core tools ---
# Generated agents start with these enabled, but they can be explicitly disabled.
# Disabling respond/no-response prevents normal turns from completing.
respond = true
no-response = true
read = true
open-file = true
close-file = true
list-dir = true
read-skill = true
session-info = true

# --- Optional built-in tools ---
write = true
edit = true
str-replace = true
read-sections = true
schedule = true
react = true
download-attachments = true
read-history = true
list-sessions = true
query-sessions = true
read-session = true
prune-boundaries = true

# --- Exec tool (sandboxed command execution) ---
# To disable, use `exec = false`.
# Binary access is configured by the selected sandbox backend. Bubblewrap uses
# [bwrap].binaries in sandbox.toml; Incus uses packages installed in its image.
exec = false

# [exec]
# enabled = true
# timeout = 60000                        # Kill timeout in ms. Default: 60000
# hostEnvPassthrough = []                # Host env vars to pass through. Default: []
#
# Output capture: short stdout/stderr is returned inline by default. Larger output
# is written to files under outputDir, and the tool result returns paths, byte counts,
# and short previews — read them with `read`/`open-file`, or filter with `exec grep …`.
# inline = true                                   # Default: true
# inlineThresholdBytes = 16384                    # Combined stdout+stderr limit for inline. Default: 16384
# outputDir = "/workspace/.exec-output"           # Sandbox-relative output directory. Default: /workspace/.exec-output
# previewHead = 20                                # Leading preview lines. Default: 20
# previewTail = 20                                # Trailing preview lines. Default: 20
