# Per-agent Discord channel configuration
# Copy to ~/.cireilclaw/agents/{slug}/config/channels/discord.toml

token = "" # Bot token from https://discord.com/developers/applications
ownerId = "" # Your Discord user ID (numeric string)
# timeout = 60000 # Discord REST request timeout in ms. Default: 60000

# [access]
# mode = "disabled"             # "disabled", "allowlist", or "denylist". Default: "disabled"
# users = []                    # Array of Discord user IDs

# [directMessages]
# mode = "owner"                # "owner", "public", "allowlist", or "denylist". Default: "owner"
# users = []                    # Array of Discord user IDs (for allowlist/denylist)

# Grant specific non-owner users permission to run specific slash commands.
# Each [[trustedUsers]] entry lists user IDs and the command names they may use.
# Command names are free strings but must match the internal handler names.
# Top-level commands: "clear", "close", "invite", "model", "repair", "stop",
# "summarize", "unsummarize".
# Subcommands are written as "<command> <subcommand>", e.g. "model query".
# Message commands (right-click -> Apps) and the sparkle reaction remain owner-only.
# Unauthorized slash command attempts receive an ephemeral "not authorized" reply.
# [[trustedUsers]]
# ids = ["987654321098765432"]
# allowedCommands = ["stop", "summarize", "model query"]
