{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "import", "promise", "typescript", "unicorn"],
  "categories": {
    "correctness": "warn",
    "nursery": "warn",
    "pedantic": "warn",
    "perf": "warn",
    "restriction": "warn",
    "style": "warn",
    "suspicious": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.tsx"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "pascalCase"
          }
        ],
        "react/react-in-jsx-scope": "off",
        "react/jsx-filename-extension": "off",
        "react/jsx-max-depth": "off",
        "react/no-array-index-key": "off",
        "react/only-export-components": "off"
      },
      "plugins": ["react", "eslint", "import", "promise", "typescript", "unicorn"]
    }
  ],
  "rules": {
    "eslint/prefer-named-capture-group": "off",
    "eslint/no-useless-assignment": "off",
    "import/no-named-export": "off",
    "import/no-relative-parent-imports": "off",
    "import/max-dependencies": "off",
    "import/prefer-default-export": "off",
    "import/no-nodejs-modules": "off",
    "import/no-namespace": "off",
    "eslint/no-duplicate-imports": "off",
    "eslint/func-style": ["error", "declaration"],
    "eslint/max-statements": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-params": "off",
    "eslint/no-plusplus": "off",
    "eslint/capitalized-comments": "off",
    "eslint/no-continue": "off",
    "eslint/complexity": "off",
    "eslint/max-depth": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-undefined": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/no-ternary": "off",
    "eslint/max-lines": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/max-classes-per-file": "off",
    "eslint/no-warning-comments": "off",
    "eslint/no-bitwise": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/strict-void-return": "off",
    "unicorn/switch-case-braces": "off",
    "eslint/prefer-object-spread": "off",
    "unicorn/prefer-ternary": "off",
    "unicorn/max-nested-calls": "off",
    "unicorn/prefer-event-target": "off",
    "unicorn/no-useless-undefined": "off",
    "typescript/method-signature-style": ["warn", "method"],
    "typescript/no-invalid-void-type": [
      "warn",
      {
        "allowAsThisParameter": true
      }
    ],
    "eslint/no-console": [
      "error",
      {
        "allow": ["debug", "info", "warn", "error", "trace"]
      }
    ],
    "eslint/sort-imports": "off",
    "promise/always-return": "off",
    "promise/avoid-new": "off",
    "promise/prefer-await-to-callbacks": "off",
    "return-await": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "unicorn/prefer-export-from": "off"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "deny"
  }
}
